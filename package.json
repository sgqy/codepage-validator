{
  "name": "codepage-validator",
  "displayName": "Codepage Validator",
  "description": "Warn about characters that cannot be saved unchanged in the current document encoding.",
  "version": "1.0.0",
  "publisher": "sgqy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgqy/codepage-validator.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.146.0",
    "node": ">=24"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "npm run check && node --test tests/unit/encoding.test.ts",
    "test:integration": "npm run build && node tests/run.mjs",
    "vscode:prepublish": "npm run check && npm run build",
    "package": "vsce package --no-dependencies",
    "build:icon": "node scripts/icon.mjs"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.146.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "icon": "media/icon.png"
}
